# PC-1 printer settings, read at startup (see app/env_file.py).
#
# Tuned for the CSN-A2 / QR204-class TTL thermal printer (115200 baud, TX/RX/GND
# only, no flow control). If you have this printer, you should not need to
# change anything here.
#
# Priority (highest first):
#   1. real environment variables (e.g. a systemd Environment= line)
#   2. printer.local.env  (optional, git-ignored: your own per-device overrides)
#   3. this file
#
# After editing, restart the app:  sudo systemctl restart pc-1.service
# Format: KEY=VALUE, one per line. Only PC1_* keys are read.

# Pause (seconds) between queued channel presses so the printer can finish feeding.
PC1_QUEUED_PRESS_SETTLE_SECONDS=10

# The printer has no flow control and a small buffer, so the app paces writes.
# Max bytes per second sent over the serial link (the link itself is 115200 baud).
PC1_SERIAL_MAX_BYTES_PER_SECOND=4800
# Extra delay (seconds) per fully-black row; solid black slows the print head.
PC1_SERIAL_DARK_ROW_SECONDS=0.05

# Paper feed after a print: a single ESC J command, 4 lines (less wasted paper).
# Options for PC1_FEED_COMMAND: both | esc_d | esc_j
PC1_FEED_COMMAND=esc_j
PC1_CUTTER_FEED_LINES=4

# Crossword blocked squares: percent of black (100 = solid, lower = lighter/faster).
PC1_CROSSWORD_BLOCK_FILL=60

# Other available settings (uncomment to use):
# PC1_PRINTER_BAUDRATE=115200    # use 9600 for printers that only support 9600
